#!/usr/bin/env bash
set -euo pipefail

service_name="little-sounds-sticker-generator.service"

if [ "$(id -u)" -ne 0 ]; then
  echo "Run generate as root."
  exit 1
fi

case "${1:-start}" in
  status)
    systemctl status "$service_name" --no-pager || true
    exit 0
    ;;
  watch)
    journalctl -u "$service_name" -f
    exit 0
    ;;
  log|logs)
    journalctl -u "$service_name" -n 80 --no-pager
    exit 0
    ;;
  start|"") ;;
  *)
    echo "Use: generate, generate status, generate watch, or generate logs"
    exit 1
    ;;
esac

if [ ! -x /opt/little-sounds-ai-venv/bin/python ] || [ ! -f /opt/little-sounds/generate_stickers.py ]; then
  echo "Install the current Little Sounds base package first."
  exit 1
fi

if systemctl is-active --quiet "$service_name" 2>/dev/null; then
  echo "The sticker generator is already running."
  echo "Watch it with: generate watch"
  exit 0
fi

while true; do
  read -r -s -p "Paste your OpenAI API key, then press Enter: " openai_key
  echo
  if [[ "$openai_key" =~ ^sk-[A-Za-z0-9_-]{20,}$ ]]; then
    break
  fi
  echo "That does not look like a complete OpenAI API key. Try again."
done

key_length="${#openai_key}"
key_start="${openai_key:0:7}"
key_end="${openai_key:key_length-4:4}"
echo "Key received: ${key_start}...${key_end} (${key_length} characters)"
echo "This fills each shared theme to 100 active stickers and only replaces designs used since the last run."
read -r -p "Start the background generator? [Y/n]: " confirmation
if [[ "$confirmation" =~ ^[Nn]$ ]]; then
  unset openai_key
  echo "Cancelled."
  exit 0
fi

umask 077
environment_file="/run/little-sounds-openai.env"
{
  printf 'OPENAI_API_KEY=%s\n' "$openai_key"
  printf 'PYTHONUNBUFFERED=1\n'
} > "$environment_file"
chmod 0600 "$environment_file"
unset openai_key

systemctl reset-failed "$service_name" 2>/dev/null || true
systemctl start "$service_name"
sleep 2
rm -f "$environment_file"

if systemctl is-failed --quiet "$service_name"; then
  echo "The generator could not start:"
  journalctl -u "$service_name" -n 30 --no-pager
  exit 1
fi

server_ip="$(hostname -I | awk '{print $1}')"
echo
echo "The generator is running safely in the background; you can close Termius."
echo "Progress page: http://${server_ip}/sticker-generator/"
echo "Watch command: generate watch"
echo "Status command: generate status"
echo "Recent log: generate logs"
