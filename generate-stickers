#!/usr/bin/env bash
set -euo pipefail
service_name="little-sounds-sticker-generator.service"
key_dir="/root/.config/little-sounds"
key_file="$key_dir/openai.env"
if [ "$(id -u)" -ne 0 ]; then echo "Run generate-stickers as root."; exit 1; fi
case "${1:-start}" in
  status) systemctl status "$service_name" --no-pager || true; exit 0 ;;
  watch) journalctl -u "$service_name" -f; exit 0 ;;
  log|logs) journalctl -u "$service_name" -n 80 --no-pager; exit 0 ;;
  forget-key) rm -f "$key_file"; echo "Saved OpenAI API key removed."; exit 0 ;;
  start|"") ;;
  *) echo "Use: generate-stickers, generate-stickers status, generate-stickers watch, generate-stickers logs, or generate-stickers forget-key"; exit 1 ;;
esac
if systemctl is-active --quiet "$service_name" 2>/dev/null; then echo "The sticker generator is already running. Watch it with: generate-stickers watch"; exit 0; fi
if [ ! -s "$key_file" ]; then
  while true; do
    read -r -s -p "Paste your OpenAI API key (you will only be asked once): " openai_key; echo
    if [[ "$openai_key" =~ ^sk-[A-Za-z0-9_-]{20,}$ ]]; then break; fi
    echo "That does not look like a complete OpenAI API key. Try again."
  done
  install -d -m 0700 "$key_dir"; umask 077
  printf 'OPENAI_API_KEY=%s\n' "$openai_key" > "$key_file"; chmod 0600 "$key_file"; unset openai_key
  echo "API key saved securely on this VPS. It is never included in backup."
else echo "Using the saved OpenAI API key."; fi
echo "This fills every shared theme to 100 active stickers and only replaces designs used by both children."
read -r -p "Start the background sticker generator? [Y/n]: " confirmation
if [[ "$confirmation" =~ ^[Nn]$ ]]; then echo "Cancelled."; exit 0; fi
cp "$key_file" /run/little-sounds-openai.env
printf 'PYTHONUNBUFFERED=1\n' >> /run/little-sounds-openai.env
chmod 0600 /run/little-sounds-openai.env
systemctl reset-failed "$service_name" 2>/dev/null || true; systemctl start "$service_name"; sleep 2
rm -f /run/little-sounds-openai.env
if systemctl is-failed --quiet "$service_name"; then journalctl -u "$service_name" -n 30 --no-pager; exit 1; fi
echo "The generator is running safely in the background; you can close Termius."
echo "Progress: http://$(hostname -I | awk '{print $1}')/sticker-generator/"
echo "Watch: generate-stickers watch"
