#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Run backup-stickers as root."
  exit 1
fi

archive="/root/stickers/little-sounds-sticker-pack.tar.gz"
repository="waqaarhussain/little-sounds-kids"
/usr/bin/python3 /opt/little-sounds/sticker_pack.py create --output "$archive"
archive_size="$(du -h "$archive" | awk '{print $1}')"
echo "Local reusable pack: $archive ($archive_size)"
echo
echo "The GitHub repository is public. Uploading means anyone can download the generated sticker images."
echo "The pack includes anonymised child albums, used-sticker state and remembered game plans. No child names, PINs or API keys are included."
read -r -p "Upload this sticker, anonymised album and game-memory pack to the public GitHub Release? [y/N]: " confirmation
if [[ ! "$confirmation" =~ ^[Yy]$ ]]; then
  echo "Upload skipped. Copy $archive somewhere outside this VPS before resetting it."
  exit 0
fi

while true; do
  read -r -s -p "Paste a GitHub token with Contents write access to $repository: " github_token
  echo
  if [[ "$github_token" =~ ^[A-Za-z0-9_]{30,}$ ]]; then
    break
  fi
  echo "That does not look like a complete GitHub token. Try again."
done

token_length="${#github_token}"
token_start="${github_token:0:7}"
token_end="${github_token:token_length-4:4}"
echo "Token received: ${token_start}...${token_end} (${token_length} characters)"
GITHUB_TOKEN="$github_token" /usr/bin/python3 /opt/little-sounds/sticker_pack.py upload "$archive" --repository "$repository"
unset github_token
echo "Future full installations will automatically restore the stickers, both child albums, used-sticker state and game variation memory."
